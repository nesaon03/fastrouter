# Keep shell scripts LF even on Windows: a CRLF checkout breaks bash
# ("syntax error near unexpected token `do\r'") and scripts/build.sh calls
# scripts/check-version.sh.
*.sh text eol=lf
*.bash text eol=lf
# PowerShell expects CRLF in some hosts; keep its scripts native.
*.ps1 text eol=crlf
# Everything else uses the platform default, but is stored normalized.
* text=auto
